# =====================================================================
# 环境变量配置模板
# 使用方法：把本文件复制为 .env（同目录下），再填入你自己的真实值。
#   Windows:  copy .env.example .env
#   Mac/Linux: cp .env.example .env
# 注意：.env 已被 .gitignore 忽略，不会被提交到 Git，请放心填写密钥。
#
# 下面的默认值均为「通用/本地」占位，你至少需要填 OPENAI_API_KEY。
# 若使用国产模型或远程向量库，请同时修改 OPENAI_BASE_URL / OPENAI_MODEL / MILVUS_URI。
# =====================================================================

# ---------- 大模型（LLM） ----------
# 你的大模型 API Key
OPENAI_API_KEY=

# 接口地址：OpenAI 官方（或任意 OpenAI 兼容的第三方中转）
# 国产模型示例：通义千问 https://dashscope.aliyuncs.com/compatible-mode/v1 ；DeepSeek https://api.deepseek.com
OPENAI_BASE_URL=https://api.openai.com/v1

# 模型名称
OPENAI_MODEL=gpt-4o-mini

# DeepSeek 专用 Key（可选）
DEEPSEEK_API_KEY=

# ---------- 网络搜索（Tavily，可选） ----------
# graph2 自适应 RAG 的"网络搜索"分支需要；申请地址 https://tavily.com
# 不需要该分支时可留空
TAVILY_API_KEY=

# ---------- 向量数据库 Milvus ----------
# 本地单机版地址（docker compose up -d 启动后即为 localhost:19530）
# 若使用远程 Milvus，改成远程地址，例如 http://your-milvus-host:19530
MILVUS_URI=http://localhost:19530

# 集合名（可自定义）
COLLECTION_NAME=t_collection01

# ---------- Embedding 向量模型 ----------
# 本地开源中文向量模型；更换模型时同步修改 documents/milvus_db.py 中 dense 维度
EMBEDDING_MODEL_NAME=BAAI/bge-small-zh-v1.5
# cpu 或 cuda
EMBEDDING_DEVICE=cpu
